  %% Diagrama C4 nível 1 — Contexto (implementado até a Fase 4)
  V(["👤 Visitante<br/><i>usuário anônimo no site do cliente</i>"])
  A(["👤 Agente<br/><i>atende filas e usa o chat interno</i>"])
  S(["👤 Supervisor<br/><i>monitora e gere setores, atividades e anúncios no seu escopo</i>"])
  AD(["👤 Administrador<br/><i>mesmo canal do supervisor, com permissões ampliadas</i>"])
  WC["<b>ViaVoip Webchat</b><br/>[Sistema]<br/>servidor central + widget ChatWeb + console"]
  HOST["Site do cliente<br/>[Sistema externo]<br/>hospeda o script widget.js"]
  SM["SM<br/>[Sistema externo — FUTURO]<br/>contrato indefinido; hoje só MockSMAdapter"]
  DOCS["ViaVOIP Docs Helper<br/>[Sistema de documentação]<br/>não é dependência operacional"]
  V -->|navega| HOST
  HOST -->|"carrega widget.js + iframe (HTTPS)"| WC
  V -->|"conversa (HTTPS + WebSocket /visitor)"| WC
  A -->|"atende e conversa (WebSocket /agent)"| WC
  S -->|"supervisiona (WebSocket /supervisor)"| WC
  AD -->|"administra (WebSocket /supervisor)"| WC
  WC -.->|"notificações de ciclo de vida (futuro, interface SMAdapter)"| SM
  DOCS -.->|"descreve — sem acoplamento em runtime"| WC
