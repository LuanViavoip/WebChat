{
  "name": "@viavoip/widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build && esbuild src/loader.ts --bundle --format=iife --outfile=dist/loader.js --target=es2020"
  },
  "dependencies": {
    "@viavoip/protocol": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
