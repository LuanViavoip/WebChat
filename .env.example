DATABASE_URL=postgres://webchat_app:webchat_app@localhost:5434/webchat
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5434/webchat
REDIS_URL=redis://localhost:6379
SM_ADAPTER=mock
PORT=3000
HOST=0.0.0.0
SEED=true
SESSION_TTL_HOURS=12
SESSION_CREATE_LIMIT=1000
LOGIN_LIMIT=20
# Obrigatório; substitua por segredo aleatório de 32+ caracteres e compartilhe entre réplicas.
LOGIN_RATE_LIMIT_SECRET=replace-with-a-random-32-byte-shared-secret
MESSAGE_LIMIT=1000
RATE_WINDOW_MS=60000
PRESENCE_STALE_MS=45000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:5174
